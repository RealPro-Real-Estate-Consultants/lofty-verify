TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZAPIER_CATCH_HOOK_URL=https://hooks.zapier.com/hooks/catch/REPLACE_ME/
ZAPIER_UPDATE_PHONE_URL=https://hooks.zapier.com/hooks/catch/REPLACE_ME/

# --- Twilio Lookup (Line Type Intelligence) — all optional -------------------
# Omit these and the built-in defaults apply. See docs/08-phone-lookup.md.
# Comma-separated Twilio line types. Blocked = no OTP and no write to Lofty.
# Flagged = OTP sends normally, but the line type is passed to Lofty.
# BLOCKED_LINE_TYPES=landline
# FLAGGED_LINE_TYPES=nonFixedVoip
# Throttle on /send-verification, which now costs a Lookup plus an SMS.
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MIN=15
